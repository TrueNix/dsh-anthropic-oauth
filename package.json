{
  "name": "dsh-anthropic-oauth",
  "version": "0.2.0",
  "description": "Bridge Claude Code OAuth (Pro/Max/Team) into DSH — reuses ~/.claude/.credentials.json, auto-refreshes, syncs ANTHROPIC_OAUTH_TOKEN, and pulls the model catalog live from /v1/models without hardcoding",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "anthropic",
    "claude",
    "oauth",
    "oidc",
    "pkce"
  ],
  "license": "MIT",
  "author": "TrueNix",
  "repository": {
    "type": "git",
    "url": "https://github.com/TrueNix/dsh-anthropic-oauth.git"
  },
  "engines": {
    "node": ">=22"
  }
}
