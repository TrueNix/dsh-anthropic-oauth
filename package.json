{
  "name": "dsh-anthropic-oauth",
  "version": "0.3.1",
  "description": "Bridge Claude Code OAuth (Pro/Max/Team) into DSH — reuses ~/.claude/.credentials.json, auto-refreshes, syncs ANTHROPIC_OAUTH_TOKEN, pulls the model catalog live from /v1/models, and shows a live subscription quota panel (5h/7d usage + reset) — without hardcoding",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "lib/credentials.js"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "anthropic",
    "claude",
    "oauth",
    "oidc",
    "pkce"
  ],
  "license": "MIT",
  "author": "TrueNix",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrueNix/dsh-anthropic-oauth.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.1.2-rc.1"
  }
}
